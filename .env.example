# Server-side default key. Used when a visitor has not pasted their own key in Settings.
# Never commit your real key. Put it in .env.local (local) or in Vercel Environment Variables (deployed).
OPENAI_API_KEY=

# Example for Groq (OpenAI-compatible):
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Example for OpenAI:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
